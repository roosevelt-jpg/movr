{
  "name": "@movr/backend",
  "version": "1.0.0",
  "description": "MOVR Super-App Backend - Node.js/TypeScript",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "build": "tsc --skipLibCheck",
    "start": "node dist/src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:seed": "ts-node --transpile-only src/scripts/seed-ops.ts",
    "db:seed-ops": "ts-node --transpile-only src/scripts/seed-ops.ts",
    "db:seed-cms": "ts-node --transpile-only src/scripts/seed-cms.ts",
    "graphql:codegen": "graphql-codegen --config codegen.yml"
  },
  "dependencies": {
    "aws-sdk": "^2.1482.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.7.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.0",
    "joi": "^17.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.0",
    "openai": "^4.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "stripe": "^13.0.0",
    "twilio": "^3.84.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "web3": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
