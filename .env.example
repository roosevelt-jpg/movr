# Server
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
# Local CORS. Production should include:
# https://mymovr.io,https://www.mymovr.io,https://admin.mymovr.io,https://stake.mymovr.io
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5180,http://127.0.0.1:5180

# Auth
JWT_SECRET=change-me-in-production
INTEGRATIONS_ENCRYPTION_KEY=change-me-integrations-encryption-key

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=movr
DB_PASSWORD=movr
DB_NAME=movr_db
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Production: never auto-complete MoMo/card/airtime without a real gateway.
# Demo instant top-ups only work when NODE_ENV !== production.
# Set ALLOW_DEMO_TOPUPS=false to disable demo even in development.
ALLOW_DEMO_TOPUPS=true
# DEPRECATED — ignored in production (demo never runs when NODE_ENV=production)
AUTO_COMPLETE_ALT_TOPUPS=false

# Stripe (Checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5180/wallet?payment=success
STRIPE_CANCEL_URL=http://localhost:5180/wallet?payment=cancelled

# KYC attestation — Movr KYCRegistry on Polygon Amoy / PoS (ethers.js).
# Not Civic / Polygon ID / Worldcoin. Hub keys polygon_amoy + kyc_registry also work
# without restart. Default RPC if unset: https://rpc-amoy.polygon.technology
# Reads need contract_address. Writes need verifier_private_key + POL for gas.
# Deploy: pnpm --filter @movr/blockchain deploy:amoy
KYC_VERIFIER_PRIVATE_KEY=
KYC_VERIFIER_ADDRESS=
KYC_REGISTRY_ADDRESS=
KYC_SUBJECT_HMAC_SECRET=
KYC_CHAIN=polygon-amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=

# DVT token / staking / claims (Phases 5B, 7, 8, 9)
TOKEN_SYSTEM_ENABLED=true
STAKING_SYSTEM_ENABLED=true
CLAIM_CUSTODIAL_ENABLED=true
DVT_TOKEN_ADDRESS=
DVT_DISTRIBUTOR_ADDRESS=
DVT_DISTRIBUTOR_PRIVATE_KEY=
DVT_MERKLE_DISTRIBUTOR_ADDRESS=
WEB3_PROVIDER_URL=

# Public web (trip share, referrals, claims)
# Local: http://localhost:5180 · Production: https://mymovr.io
PUBLIC_WEB_URL=http://localhost:5180
DEFAULT_EMERGENCY_NUMBER=191

# Twilio (SMS / WhatsApp OTP + masked calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PROXY_NUMBER=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_BUSINESS_NUMBER=

# Email (SendGrid) — department From addresses + signatures (@mymovr.io)
SENDGRID_API_KEY=
EXPOSE_OTP=true
EMAIL_FROM_CEO=ceo@mymovr.io
EMAIL_FROM_CEO_NAME=Roosevelt Adom, CEO · Movr
EMAIL_REPLY_CEO=ceo@mymovr.io
EMAIL_FROM_SUPPORT=support@mymovr.io
EMAIL_FROM_SECURITY=security@mymovr.io
EMAIL_FROM_OPS=ops@mymovr.io
EMAIL_FROM_DRIVERS=drivers@mymovr.io
EMAIL_FROM_MERCHANTS=merchants@mymovr.io
EMAIL_FROM_PRODUCT=hello@mymovr.io
ADMIN_URL=http://localhost:3002

# Frontend
REACT_APP_API_URL=http://localhost:3000/api/v1
# Production web: VITE_API_URL=https://api.mymovr.io/api/v1
# Production admin: https://admin.mymovr.io

# OpenAI (Whisper + voice intent — Phase 23)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Auth (email verification + phone OTP) and FCM.
# Also configurable in Admin → Integrations Hub (firebase_auth / firebase_fcm).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_RECAPTCHA_SITE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
EXPO_ACCESS_TOKEN=

# Sentry (Phase 21)
SENTRY_DSN=
VITE_SENTRY_DSN=
REACT_APP_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
REACT_APP_SOCKET_URL=http://localhost:3000

# Channel bots (Phase 22)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MovrAIBot
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Autonomous ride loop (Phase 1)
AUTO_ASSIGN_OFFER_SECONDS=45
AUTO_ASSIGN_MAX_ATTEMPTS=5
AUTO_REVIEW_HOURS=24
# Auto-close all open trust surfaces (disputes, SOS, tickets, incidents)
AUTO_DISPUTE_CLOSE_HOURS=2
AUTO_CRITICAL_CLOSE_HOURS=6
AUTO_SOS_CLOSE_MINUTES=30
AUTO_SOS_HARD_CLOSE_HOURS=2
AUTO_TICKET_CLOSE_HOURS=4
