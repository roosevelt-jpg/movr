# =============================================================================
# MOVR PRODUCTION — API (ECS / Secrets Manager)
# Hosts: api.mymovr.io · mymovr.io · admin.mymovr.io
# =============================================================================

# --- Core (required) ---
NODE_ENV=production
APP_PORT=3000
APP_URL=https://api.mymovr.io
PUBLIC_WEB_URL=https://mymovr.io
ADMIN_URL=https://admin.mymovr.io
CORS_ORIGIN=https://mymovr.io,https://www.mymovr.io,https://admin.mymovr.io,https://stake.mymovr.io,https://api.mymovr.io

JWT_SECRET=<long-random-64+>
INTEGRATIONS_ENCRYPTION_KEY=<long-random-64+>

LOG_LEVEL=info
EXPOSE_OTP=false
ALLOW_DEMO_TOPUPS=false
AUTO_COMPLETE_ALT_TOPUPS=false

# --- Postgres / Redis (required) ---
DB_HOST=<rds-endpoint>
DB_PORT=5432
DB_USER=movr
DB_PASSWORD=<secret>
DB_NAME=movr_db
DB_POOL_MAX=20
DB_POOL_MIN=2
# DATABASE_URL=postgresql://movr:PASSWORD@host:5432/movr_db

REDIS_HOST=<elasticache-endpoint>
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- Payments (required for live pay) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://mymovr.io/wallet?payment=success
STRIPE_CANCEL_URL=https://mymovr.io/wallet?payment=cancelled

# --- Twilio / email ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PROXY_NUMBER=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_BUSINESS_NUMBER=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=

SENDGRID_API_KEY=
EMAIL_FROM_CEO=ceo@mymovr.io
EMAIL_FROM_CEO_NAME=Roosevelt Adom, CEO · Movr
EMAIL_REPLY_CEO=ceo@mymovr.io
EMAIL_FROM_SUPPORT=support@mymovr.io
EMAIL_FROM_SECURITY=security@mymovr.io
EMAIL_FROM_OPS=ops@mymovr.io
EMAIL_FROM_DRIVERS=drivers@mymovr.io
EMAIL_FROM_MERCHANTS=merchants@mymovr.io
EMAIL_FROM_PRODUCT=hello@mymovr.io

# --- Firebase / push ---
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_RECAPTCHA_SITE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Maps / AI / observability ---
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SENTRY_DSN=

# --- AWS S3 (uploads / trip recordings; prefer IAM role on ECS) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=mymovr-uploads-prod
# TRIP_RECORDING_ENABLED=true
# TRIP_RECORDING_RETENTION_HOURS=72

# --- KYC / blockchain (optional until enabled) ---
KYC_CHAIN=polygon-amoy
KYC_REGISTRY_ADDRESS=
KYC_VERIFIER_PRIVATE_KEY=
KYC_VERIFIER_ADDRESS=
KYC_SUBJECT_HMAC_SECRET=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=
# POLYGON_AMOY_WSS_URL=

TOKEN_SYSTEM_ENABLED=true
STAKING_SYSTEM_ENABLED=true
CLAIM_CUSTODIAL_ENABLED=true
DVT_TOKEN_ADDRESS=
DVT_DISTRIBUTOR_ADDRESS=
DVT_DISTRIBUTOR_PRIVATE_KEY=
DVT_MERKLE_DISTRIBUTOR_ADDRESS=
WEB3_PROVIDER_URL=
# WEB3_PRIVATE_KEY=

# --- Channel bots ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MovrAIBot
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=

# --- Ops defaults ---
DEFAULT_EMERGENCY_NUMBER=191
DEFAULT_COUNTRY=GH
AUTO_ASSIGN_OFFER_SECONDS=45
AUTO_ASSIGN_MAX_ATTEMPTS=5
AUTO_REVIEW_HOURS=24
AUTO_DISPUTE_CLOSE_HOURS=2
AUTO_CRITICAL_CLOSE_HOURS=6
AUTO_SOS_CLOSE_MINUTES=30
AUTO_SOS_HARD_CLOSE_HOURS=2
AUTO_TICKET_CLOSE_HOURS=4

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# web + admin builds
VITE_API_URL=https://api.mymovr.io/api/v1
REACT_APP_API_URL=https://api.mymovr.io/api/v1
REACT_APP_SOCKET_URL=https://api.mymovr.io
VITE_SENTRY_DSN=
REACT_APP_SENTRY_DSN=

EXPO_PUBLIC_API_URL=https://api.mymovr.io/api/v1
EXPO_PUBLIC_WEB_URL=https://mymovr.io
EXPO_PUBLIC_SENTRY_DSN=

VITE_API_URL=https://api.mymovr.io/api/v1
VITE_STAKING_POOL_ADDRESS=
VITE_DVT_TOKEN_ADDRESS=
VITE_DVT_MERKLE_DISTRIBUTOR_ADDRESS=
VITE_CLAIM_PAGE_URL=https://mymovr.io/claim

DB_HOST=localhost
DB_PORT=5432
DB_USER=movr
DB_PASSWORD=movr
DB_NAME=movr_db