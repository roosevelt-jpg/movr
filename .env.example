# Channel bots (Phase 22)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MovrAIBot
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Trip recording (Phase 28) — local record + async upload
TRIP_RECORDING_ENABLED=true
