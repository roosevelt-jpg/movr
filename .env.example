# Server
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Auth
JWT_SECRET=change-me-in-production
INTEGRATIONS_ENCRYPTION_KEY=change-me-integrations-encryption-key

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=movr
DB_PASSWORD=movr
DB_NAME=movr_db
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Stripe (Checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5180/wallet?payment=success
STRIPE_CANCEL_URL=http://localhost:5180/wallet?payment=cancelled

# KYC attestation (Phase 5A) — Polygon Amoy / PoS
KYC_VERIFIER_PRIVATE_KEY=
KYC_VERIFIER_ADDRESS=
KYC_REGISTRY_ADDRESS=
KYC_SUBJECT_HMAC_SECRET=
KYC_CHAIN=polygon-amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=

# DVT token / staking / claims (Phases 5B, 7, 8, 9)
TOKEN_SYSTEM_ENABLED=true
STAKING_SYSTEM_ENABLED=true
CLAIM_CUSTODIAL_ENABLED=true
DVT_TOKEN_ADDRESS=
DVT_DISTRIBUTOR_ADDRESS=
DVT_DISTRIBUTOR_PRIVATE_KEY=
DVT_MERKLE_DISTRIBUTOR_ADDRESS=
WEB3_PROVIDER_URL=

# Public web (trip share)
PUBLIC_WEB_URL=http://localhost:3003
DEFAULT_EMERGENCY_NUMBER=191

# Twilio (SMS / WhatsApp OTP + masked calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PROXY_NUMBER=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_BUSINESS_NUMBER=

# Email (SendGrid) — department From addresses + signatures
SENDGRID_API_KEY=
EXPOSE_OTP=true
EMAIL_FROM_CEO=ceo@movr.app
EMAIL_FROM_CEO_NAME=Roosevelt Adom, CEO · Movr
EMAIL_REPLY_CEO=ceo@movr.app
EMAIL_FROM_SUPPORT=support@movr.app
EMAIL_FROM_SECURITY=security@movr.app
EMAIL_FROM_OPS=ops@movr.app
EMAIL_FROM_DRIVERS=drivers@movr.app
EMAIL_FROM_MERCHANTS=merchants@movr.app
EMAIL_FROM_PRODUCT=hello@movr.app
ADMIN_URL=http://localhost:3002

# Frontend
REACT_APP_API_URL=http://localhost:3000/api/v1

# OpenAI (Whisper + voice intent — Phase 23)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sentry (Phase 21)
SENTRY_DSN=
VITE_SENTRY_DSN=
REACT_APP_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
