# Copy keys into Admin → Integrations Hub (preferred) or local .env for EAS secrets.
EXPO_PUBLIC_API_URL=https://api.mymovr.io/api/v1
EXPO_PUBLIC_WEB_URL=https://mymovr.io
# FCM: copy google-services.json from Firebase into this folder (package io.movr.app).
# Tokens register at POST /api/v1/devices/fcm.
# Firebase Auth email + phone OTP uses GET /api/v1/public/firebase-config from the API.
# After Expo login: npx eas init  → paste projectId into app.json extra.eas.projectId
